<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Detector and scoring tests run against synthetic fact-sets, so detection
    logic is verifiable without needing a live infected machine.
  -->

  <PropertyGroup>
    <RootNamespace>RatScan.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RatScan.Engine\RatScan.Engine.csproj" />
    <ProjectReference Include="..\RatScan.Etw\RatScan.Etw.csproj" />
    <ProjectReference Include="..\RatScan.Native\RatScan.Native.csproj" />
    <ProjectReference Include="..\RatScan.Rules\RatScan.Rules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
