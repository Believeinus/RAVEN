<!--
    The shell: title bar, navigation, tray. Every view lives in its own Page.

    WindowBackdropType is None rather than Mica on purpose. Mica renders the user's desktop
    wallpaper through the window, which is a strange thing for a tool that exists to tell
    them what is watching their screen - and it leaves no surface to put the RAVEN mark on.
    A flat dark surface with the logo behind it is the trade taken here.
-->
<ui:FluentWindow x:Class="RatScan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:RatScan.UI.Pages"
        Title="RAVEN" Height="860" Width="1240"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowCornerPreference="Round"
        Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The mark, behind everything at low opacity and bottom-right, away from the
            findings column where the dense text lives. It is decoration on a tool whose
            text has to stay readable, so it gets no hit testing and very little contrast.
        -->
        <Image Grid.RowSpan="3"
               Source="Assets/raven-tile.png"
               Opacity="0.05"
               Stretch="Uniform"
               Width="780"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Margin="0,0,-100,-150"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <ui:TitleBar Grid.Row="0" Title="RAVEN" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="Assets/raven-tile.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--
            Reduced coverage is shell-level, not a Scan-view detail: it is true of every
            view and it changes what all of them are worth. Shown until it stops being true.
        -->
        <ui:InfoBar Grid.Row="1" x:Name="ElevationBar"
                    Severity="Warning" IsClosable="False" IsOpen="False"
                    Margin="24,0,24,8"
                    Title="Not running as Administrator"
                    Message="Kernel driver identities, the object-manager driver directory, the Security event log, SMB sessions and the live watch are all out of reach. Scans still run, and every gap is listed rather than passed over." />

        <ui:NavigationView Grid.Row="2" x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="190">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Scan" TargetPageType="{x:Type pages:ScanPage}"
                                       Icon="{ui:SymbolIcon ScanType24}" />
                <ui:NavigationViewItem Content="Live watch" TargetPageType="{x:Type pages:LiveWatchPage}"
                                       Icon="{ui:SymbolIcon Eye24}" />
                <ui:NavigationViewItem Content="History" TargetPageType="{x:Type pages:HistoryPage}"
                                       Icon="{ui:SymbolIcon History24}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}"
                                       Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--
            Every confirmation in the app is shown here, over all three rows and above the
            navigation, so a prompt cannot be mistaken for part of the view behind it.

            One host per window is the framework's rule, and one host is also the product's:
            confirmation before a mutating action is an invariant here, so the thing that
            renders it belongs to the shell rather than to whichever page happens to ask.
            Siblings are disabled while a dialog is up - a prompt the user can click behind
            is not a guard.
        -->
        <ui:ContentDialogHost Grid.RowSpan="3" x:Name="RootDialogHost"
                              IsDisableSiblingsEnabled="True" />

        <!--
            Tray presence, and the only reason this window may outlive its own Close.

            Deliberately absent: any form of start-with-Windows. RAVEN reports other software
            that configures itself to start automatically; giving itself a Run key would make
            the tool an instance of the thing it flags.
        -->
        <tb:TaskbarIcon x:Name="Tray"
                        Visibility="Collapsed"
                        ToolTipText="RAVEN — not watching"
                        TrayLeftMouseUp="OnTrayShowClick">
            <!--
                The logo identifies it; the dot in the corner says whether it is doing
                anything. Both are needed - a tray icon that looks identical whether the
                watch is running or dead is worse than no tray icon at all.
            -->
            <tb:TaskbarIcon.IconFrameworkElementSource>
                <Grid Width="32" Height="32" Background="Transparent">
                    <Image Source="Assets/raven-tile.png" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Ellipse x:Name="TrayDot" Width="13" Height="13"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Fill="#8B93A1" Stroke="#0F1115" StrokeThickness="2" />
                </Grid>
            </tb:TaskbarIcon.IconFrameworkElementSource>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show RAVEN" Click="OnTrayShowClick" />
                    <MenuItem x:Name="TrayStopItem" Header="Stop watching" Click="OnTrayStopWatchingClick" />
                    <Separator />
                    <MenuItem Header="Quit RAVEN" Click="OnTrayQuitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
