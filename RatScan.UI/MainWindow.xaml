<Window x:Class="RatScan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatScan" Height="820" Width="1180"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="Manual"
        Background="#0F1115">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E6E8EC" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
        <SolidColorBrush x:Key="Panel" Color="#161A21" />
        <SolidColorBrush x:Key="Line" Color="#242A34" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!--
            WPF's stock scrollbar is a light-theme control: pale track, black arrows.
            Dropped onto this window it renders as a white stripe with invisible-ish
            glyphs down the side of every panel. Replaced with a flat dark thumb.
        -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#3A4250" CornerRadius="3" Margin="2,0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}"
                                                  Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="RatScan" FontSize="26" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="13"
                           Text="Find and shut down remote access and surveillance on Windows" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ElevationText" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="12" Foreground="{StaticResource Muted}" />
                <Button x:Name="ExportButton" Content="Export report" Click="OnExportClick"
                        Background="#2A3242" IsEnabled="False" Margin="0,0,10,0" />
                <Button x:Name="ScanButton" Content="Run full scan" Click="OnScanClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VerdictStripe" Grid.Column="0" CornerRadius="3"
                            Background="#8B93A1" Margin="0,2,14,2" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeadlineText" FontSize="19" FontWeight="SemiBold"
                                   Text="No scan has been run yet." />
                        <TextBlock x:Name="SummaryText" Margin="0,10,0,0" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource Muted}"
                                   Text="Press Run full scan. RatScan examines running processes, network listeners, Windows' own remote-access features, auto-start entries and kernel drivers." />
                    </StackPanel>
                </Grid>
                <!--
                    What changed since last time sits with the verdict, not in a
                    separate history screen. A new remote-access tool appearing
                    overnight is the single most actionable thing this tool can say,
                    and it is worthless if the user has to go looking for it.
                -->
                <Border x:Name="ChangePanel" Visibility="Collapsed" Margin="20,16,0,0"
                        Background="#12161D" BorderBrush="#242A34" BorderThickness="1"
                        CornerRadius="6" Padding="14,12">
                    <StackPanel>
                        <TextBlock x:Name="ChangeHeader" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="#B7C4DA" />
                        <ItemsControl x:Name="ChangeList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="{Binding Marker}" FontFamily="Consolas"
                                                   FontSize="12" Margin="0,0,8,0"
                                                   Foreground="{Binding MarkerBrush}" />
                                        <TextBlock Text="{Binding Text}" FontSize="12"
                                                   TextWrapping="Wrap" Foreground="#8B93A1" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ChangeCaveat" FontSize="11.5" LineHeight="17"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#E8C939"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="ScanProgress" Height="3" Margin="20,16,0,0" IsIndeterminate="True"
                             Visibility="Collapsed" Background="Transparent" Foreground="{StaticResource Accent}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               x:Name="FindingsHeader" Text="FINDINGS" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <ItemsControl x:Name="FindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding SeverityBrush}" CornerRadius="4"
                                                        Padding="7,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="10"
                                                               FontWeight="Bold" Foreground="#0F1115" />
                                                </Border>
                                                <TextBlock Text="{Binding ConfidenceLabel}" FontSize="10" TextWrapping="Wrap"
                                                           VerticalAlignment="Center" Foreground="#8B93A1" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Explanation}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                                       Margin="0,6,0,0" Foreground="#8B93A1" />
                                            <TextBlock Text="{Binding Recommendation}" FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                                                       Margin="0,8,0,0" Foreground="#B7C4DA"
                                                       Visibility="{Binding RecommendationVisibility}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <ItemsControl ItemsSource="{Binding Actions}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Content="{Binding Title}"
                                                                    Tag="{Binding}"
                                                                    Click="OnFixClick"
                                                                    Background="#2A3242"
                                                                    Padding="12,6" FontSize="12"
                                                                    Margin="0,0,8,6" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Deliberately quieter than the fix buttons: muting
                                                     is a decision to stop being told, and it should
                                                     never be the most inviting thing on the row. -->
                                                <Button Content="This is mine — mute it"
                                                        Tag="{Binding Finding}"
                                                        Click="OnMuteClick"
                                                        Visibility="{Binding MuteVisibility}"
                                                        Background="Transparent"
                                                        Foreground="#8B93A1"
                                                        Padding="12,6" FontSize="12" FontWeight="Normal"
                                                        Margin="0,0,8,6" />
                                            </WrapPanel>
                                            <Expander Header="Evidence" Margin="0,8,0,0" Foreground="#8B93A1"
                                                      FontSize="11">
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="4,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                                       Margin="0,2" Foreground="#8B93A1"
                                                                       Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--
                            Muted findings are listed, not hidden. The whole risk of an
                            allowlist is that it becomes somewhere things quietly go, so
                            what has been silenced stays on the same screen as what has
                            not, with the reason the user gave and the date they gave it.
                        -->
                        <StackPanel x:Name="MutedSection" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" x:Name="MutedHeader"
                                       Margin="0,0,0,4" Text="MUTED BY YOU" />
                            <TextBlock x:Name="MutedNote" FontSize="11.5" LineHeight="17"
                                       Foreground="#8B93A1" Margin="0,0,0,8" />
                            <ItemsControl x:Name="MutedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#242A34" BorderThickness="0,0,0,1"
                                                Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextWrapping="Wrap"
                                                               FontWeight="SemiBold" Foreground="#B7C4DA" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="11.5" TextWrapping="Wrap"
                                                               LineHeight="17" Margin="0,3,0,0"
                                                               Foreground="#8B93A1" />
                                                    <TextBlock Text="{Binding Pin}" FontSize="11" TextWrapping="Wrap"
                                                               LineHeight="16" Margin="0,3,0,0"
                                                               Foreground="{Binding PinBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Unmute"
                                                        Tag="{Binding Entry}" Click="OnUnmuteClick"
                                                        Background="#2A3242" Padding="12,6"
                                                        FontSize="12" VerticalAlignment="Top" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="SCAN INTEGRITY" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="IntegrityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                                       Margin="16,3,0,0" Foreground="#8B93A1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   x:Name="BlindspotHeader" Text="WHAT THIS SCAN COULD NOT SEE" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="BlindspotList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Area}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Reason}" FontSize="11.5" LineHeight="17" TextWrapping="Wrap"
                                                       Margin="0,3,0,0" Foreground="#8B93A1" />
                                            <TextBlock Text="{Binding Remedy}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"
                                                       Foreground="#B7C4DA"
                                                       Visibility="{Binding RemedyVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
