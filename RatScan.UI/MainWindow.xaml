<Window x:Class="RatScan.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatScan" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E6E8EC" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />
        <SolidColorBrush x:Key="Panel" Color="#161A21" />
        <SolidColorBrush x:Key="Line" Color="#242A34" />
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="RatScan" FontSize="26" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource Muted}" FontSize="13"
                           Text="Remote-access and surveillance audit for Windows" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="ElevationText" VerticalAlignment="Center" Margin="0,0,16,0"
                           FontSize="12" Foreground="{StaticResource Muted}" />
                <Button x:Name="ScanButton" Content="Run full scan" Click="OnScanClick" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VerdictStripe" Grid.Column="0" CornerRadius="3"
                            Background="#8B93A1" Margin="0,2,14,2" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeadlineText" FontSize="19" FontWeight="SemiBold"
                                   Text="No scan has been run yet." />
                        <TextBlock x:Name="SummaryText" Margin="0,10,0,0" FontSize="13" LineHeight="20"
                                   Foreground="{StaticResource Muted}"
                                   Text="Press Run full scan. RatScan examines running processes, network listeners, Windows' own remote-access features, auto-start entries and kernel drivers." />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="ScanProgress" Height="3" Margin="20,16,0,0" IsIndeterminate="True"
                             Visibility="Collapsed" Background="Transparent" Foreground="{StaticResource Accent}"
                             BorderThickness="0" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               x:Name="FindingsHeader" Text="FINDINGS" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FindingsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#242A34" BorderThickness="0,0,0,1" Padding="0,12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding SeverityBrush}" CornerRadius="4"
                                                        Padding="7,2" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontSize="10"
                                                               FontWeight="Bold" Foreground="#0F1115" />
                                                </Border>
                                                <TextBlock Text="{Binding ConfidenceLabel}" FontSize="10"
                                                           VerticalAlignment="Center" Foreground="#8B93A1" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding Explanation}" FontSize="12.5" LineHeight="19"
                                                       Margin="0,6,0,0" Foreground="#8B93A1" />
                                            <TextBlock Text="{Binding Recommendation}" FontSize="12.5" LineHeight="19"
                                                       Margin="0,8,0,0" Foreground="#B7C4DA"
                                                       Visibility="{Binding RecommendationVisibility}" />
                                            <Expander Header="Evidence" Margin="0,8,0,0" Foreground="#8B93A1"
                                                      FontSize="11">
                                                <ItemsControl ItemsSource="{Binding Evidence}" Margin="4,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontFamily="Consolas" FontSize="11.5"
                                                                       Margin="0,2" Foreground="#8B93A1"
                                                                       Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="SCAN INTEGRITY" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IntegrityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="11.5" LineHeight="17"
                                                       Margin="16,3,0,0" Foreground="#8B93A1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   x:Name="BlindspotHeader" Text="WHAT THIS SCAN COULD NOT SEE" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="BlindspotList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Area}" FontSize="12.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Reason}" FontSize="11.5" LineHeight="17"
                                                       Margin="0,3,0,0" Foreground="#8B93A1" />
                                            <TextBlock Text="{Binding Remedy}" FontSize="11.5" Margin="0,3,0,0"
                                                       Foreground="#B7C4DA"
                                                       Visibility="{Binding RemedyVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
