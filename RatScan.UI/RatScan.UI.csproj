<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF shell: a plain Window with code-behind and a hand-rolled dark theme.

    Runs as asInvoker by manifest, deliberately. Without Administrator the tool
    cannot open every process, enumerate kernel drivers, or start an ETW session —
    and the whole point is that it must be able to show a user what it cannot see.
    Forcing elevation would make that degraded path unreachable and untestable.
    The window reports the reduced coverage and offers "Restart as Administrator".
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>RatScan.UI</RootNamespace>
    <AssemblyName>RAVEN</AssemblyName>
    <Product>RAVEN</Product>
    <AssemblyTitle>RAVEN — Remote Access &amp; Visibility Examination Node</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Assets\raven.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Artwork lives in the repo-root Assets folder and is linked in rather than copied, so
    there is one master. RAVEN-LOGO.png is deliberately NOT included: it is 2048x2048 and
    7.7 MB, and both files below are generated from it, cropped to the wings and body so
    the bird survives being drawn at 16 px.

    WPF takes the window and taskbar icon from ApplicationIcon on its own, so Window.Icon
    is left unset - that way the title bar gets whichever frame of the .ico fits the
    current DPI instead of one bitmap stretched to every size.
  -->
  <ItemGroup>
    <Resource Include="..\Assets\raven-tile.png" Link="Assets\raven-tile.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RatScan.Engine\RatScan.Engine.csproj" />
    <ProjectReference Include="..\RatScan.Etw\RatScan.Etw.csproj" />
    <ProjectReference Include="..\RatScan.Native\RatScan.Native.csproj" />
    <ProjectReference Include="..\RatScan.Rules\RatScan.Rules.csproj" />
  </ItemGroup>

  <!--
    Two package references, both of which are now actually used.

    WPF-UI was referenced from phase 0 and removed on 2026-08-01 for claiming an
    architecture that did not exist: the shell was a plain Window with a hand-rolled
    theme and nothing imported Wpf.Ui anywhere. The note left behind said to re-add it
    when something actually used it, and that condition is now met - the shell is a
    FluentWindow and the theme comes from ThemesDictionary rather than from a handful of
    hex literals. Same story for the tray icon, which is the only way the live watch can
    outlive its window.

    CommunityToolkit.Mvvm and Microsoft.Extensions.Hosting stay removed. There is still
    no view-model layer and no host, and listing them would restate the same small
    dishonesty the removal was about.
  -->
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

</Project>
