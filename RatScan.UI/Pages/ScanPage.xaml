<!--
    The verdict and what backs it up.

    ScrollViewer.CanContentScroll="False" is required, not cosmetic: WPF-UI's
    NavigationViewContentPresenter otherwise wraps the whole page in a DynamicScrollViewer,
    which scrolls the toolbar along with the content and leaves the inner lists with
    infinite height so they never scroll themselves.
-->
<Page x:Class="RatScan.UI.Pages.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: the actions this view owns. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Scan" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ui:Button x:Name="ExportButton" Content="Export report" Click="OnExportClick"
                           Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="False"
                           Appearance="Secondary" Margin="0,0,8,0" MinHeight="32" />
                <ui:Button x:Name="ScanButton" Content="Run full scan" Click="OnScanClick"
                           Icon="{ui:SymbolIcon ScanType24}" Appearance="Primary" MinHeight="32" />
            </StackPanel>
        </Grid>

        <!-- Row 1: verdict. Always coverage-qualified; never a clean bill of health. -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="VerdictStripe" Grid.Column="0" CornerRadius="3"
                            Background="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,16,2" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="HeadlineText" FontSize="20" FontWeight="SemiBold"
                                   Text="No scan has been run yet." />
                        <TextBlock x:Name="SummaryText" Margin="0,8,0,0" FontSize="14" LineHeight="21"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Press Run full scan. RAVEN examines running processes, network listeners, Windows' own remote-access features, auto-start entries and kernel drivers." />
                    </StackPanel>
                </Grid>

                <!--
                    What changed since last time sits with the verdict, not on the History
                    view. A new remote-access tool appearing overnight is the single most
                    actionable thing this tool can say, and it is worthless if the user has
                    to go looking for it.
                -->
                <Border x:Name="ChangePanel" Visibility="Collapsed" Margin="22,16,0,0"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="ChangeHeader" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <!--
                            Capped and scrollable: this list has no natural size limit. A scan
                            whose coverage differs from the previous one produces a diff entry
                            per kernel driver - a hundred rows - and uncapped it drove every
                            card below it off the bottom of the window. The real cap is set
                            against window height in UpdateChangeListCap.
                        -->
                        <ScrollViewer x:Name="ChangeScroll" Margin="0,8,0,0" MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ChangeList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Marker}" FontFamily="Cascadia Mono, Consolas"
                                                       FontSize="12" Margin="0,0,8,0"
                                                       Foreground="{Binding MarkerBrush}" />
                                            <TextBlock Text="{Binding Text}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="ChangeCaveat" FontSize="12" LineHeight="18"
                                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#E8C939"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="ScanProgress" Height="3" Margin="22,16,0,0" IsIndeterminate="True"
                             Visibility="Collapsed" Background="Transparent" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- Row 2: findings, with coverage beside them. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                               x:Name="FindingsHeader" Text="FINDINGS" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl x:Name="FindingsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1" Padding="0,14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="{Binding SeverityBrush}" CornerRadius="4"
                                                            Padding="8,3" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding SeverityLabel}" FontSize="12"
                                                                   FontWeight="Bold" Foreground="#0F1115" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ConfidenceLabel}" FontSize="12"
                                                               TextWrapping="Wrap" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Margin="0,10,0,0" />
                                                <TextBlock Text="{Binding Explanation}" FontSize="14" LineHeight="21"
                                                           TextWrapping="Wrap" Margin="0,8,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Recommendation}" FontSize="14" LineHeight="21"
                                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                                           Visibility="{Binding RecommendationVisibility}" />
                                                <WrapPanel Margin="0,12,0,0">
                                                    <ItemsControl ItemsSource="{Binding Actions}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ui:Button Content="{Binding Title}" Tag="{Binding}"
                                                                           Click="OnFixClick" Appearance="Caution"
                                                                           FontSize="12" Margin="0,0,8,8" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Deliberately quieter than the fix buttons: muting is a
                                                         decision to stop being told, and it should never be the
                                                         most inviting thing on the row. -->
                                                    <ui:Button Content="This is mine — mute it"
                                                               Tag="{Binding Finding}" Click="OnMuteClick"
                                                               Visibility="{Binding MuteVisibility}"
                                                               Appearance="Transparent" FontSize="12"
                                                               Margin="0,0,8,8" />
                                                </WrapPanel>
                                                <Expander Header="Evidence" Margin="0,8,0,0" FontSize="12">
                                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="4,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="12" TextWrapping="Wrap"
                                                                           Margin="0,3"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                           Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--
                                Muted findings are listed, not hidden. The whole risk of an
                                allowlist is that it becomes somewhere things quietly go, so
                                what has been silenced stays on the same screen as what has not.
                            -->
                            <StackPanel x:Name="MutedSection" Visibility="Collapsed" Margin="0,24,0,0">
                                <TextBlock x:Name="MutedHeader" Style="{StaticResource SectionTitle}"
                                           Text="MUTED BY YOU" />
                                <TextBlock x:Name="MutedNote" FontSize="12" LineHeight="18"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ItemsControl x:Name="MutedList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,0,0,1" Padding="0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Reason}" FontSize="12"
                                                                   LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Text="{Binding Pin}" FontSize="12"
                                                                   LineHeight="18" TextWrapping="Wrap" Margin="0,4,0,0"
                                                                   Foreground="{Binding PinBrush}" />
                                                    </StackPanel>
                                                    <ui:Button Grid.Column="1" Content="Unmute"
                                                               Tag="{Binding Entry}" Click="OnUnmuteClick"
                                                               Appearance="Secondary" FontSize="12"
                                                               VerticalAlignment="Top" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Coverage. Two cards, each with room now that live watch has its own view. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   Text="SCAN INTEGRITY" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="IntegrityList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" Fill="{Binding StateBrush}" />
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12" LineHeight="18"
                                                       TextWrapping="Wrap" Margin="16,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                                   x:Name="BlindspotHeader" Text="WHAT THIS SCAN COULD NOT SEE" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="BlindspotList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Area}" FontSize="14" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Reason}" FontSize="12" LineHeight="18"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Remedy}" FontSize="12" LineHeight="18"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#E8C939"
                                                       Visibility="{Binding RemedyVisibility}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
