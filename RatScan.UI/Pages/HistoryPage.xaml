<Page x:Class="RatScan.UI.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="History" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,8" />

        <!--
            Every row states whether it ran elevated. Two scans with different coverage are
            not two readings of the same thing, and a history that hides that invites
            exactly the comparison it should prevent - "it was clean last week" when last
            week simply saw less.
        -->
        <TextBlock Grid.Row="1" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Scans are recorded locally so each one can be compared with the last. Coverage is shown on every row: a scan that ran without Administrator saw less, so a finding missing from it may only have been out of view." />

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           x:Name="HistoryHeader" Text="RECORDED SCANS" />

                <TextBlock DockPanel.Dock="Top" x:Name="HistoryEmpty" FontSize="14" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" CornerRadius="2" Margin="0,2,14,2"
                                                Background="{Binding VerdictBrush}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding When}" FontSize="14"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Verdict}" FontSize="12"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding VerdictBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Headline}" FontSize="14" LineHeight="21"
                                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Coverage}" FontSize="12" Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
