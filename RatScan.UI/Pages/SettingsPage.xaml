<Page x:Class="RatScan.UI.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left">

                <!-- Coverage first, because it decides what everything else is worth. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="COVERAGE" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock x:Name="ElevationText" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="ElevationDetail" FontSize="14" LineHeight="21"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" x:Name="ElevateButton"
                                       Content="Restart as Administrator" Click="OnElevateClick"
                                       Icon="{ui:SymbolIcon ShieldTask24}" Appearance="Primary"
                                       VerticalAlignment="Top" MinHeight="32" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- The allowlist is the one feature whose purpose is to make the tool say
                     less, so what it holds is stated here in full rather than summarised. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" x:Name="AllowlistHeader"
                                   Text="ALLOWLIST" />
                        <TextBlock x:Name="AllowlistNote" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="WHERE YOUR DATA IS" />
                        <TextBlock FontSize="14" LineHeight="21" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Scan history, the allowlist and baselines are kept in a local SQLite database. Nothing is uploaded and there is no account. The database records what is running on this machine — program paths, connections and usernames — so treat it as you would any other record of your computer." />
                        <TextBlock x:Name="DataPathText" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="ABOUT" />
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="RAVEN" />
                        <TextBlock FontSize="14" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Remote Access &amp; Visibility Examination Node" />
                        <TextBlock FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="RAVEN runs in user mode. Code running in the Windows kernel, in a hypervisor beneath Windows, or in hardware attached to this machine can return clean answers to every check it performs. That is why it never reports that a machine is clean — only what it examined, and what it could not." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
