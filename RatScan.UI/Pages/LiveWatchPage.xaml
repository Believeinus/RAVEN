<!--
    A scan describes an instant. This is the only part of RAVEN that can see a program
    which starts, beacons and exits between two scans - and it says plainly when it is not
    running, because a watcher that is silently not watching is the most dangerous state
    this component can be in.
-->
<Page x:Class="RatScan.UI.Pages.LiveWatchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      ScrollViewer.CanContentScroll="False"
      Background="Transparent">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="WatchHeader" Text="Live watch — off"
                           FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Ellipse x:Name="WatchDot" Width="10" Height="10" Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <ui:Button x:Name="WatchButton" Content="Start watching" Click="OnWatchClick"
                       Icon="{ui:SymbolIcon Eye24}" Appearance="Primary"
                       HorizontalAlignment="Right" VerticalAlignment="Center" MinHeight="32" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <TextBlock x:Name="WatchStatus" FontSize="14" LineHeight="21" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Not running. A scan samples the machine at one moment — anything that starts, connects and exits between scans is invisible to it. Watching needs Administrator." />
        </Border>

        <!--
            Alerts are deliberately rare - a catalogued remote-access tool starting, once
            per tool per session - so they get their own card above the feed rather than
            being one more line scrolling past inside it.
        -->
        <Border Grid.Row="2" x:Name="AlertSection" Style="{StaticResource Card}"
                Margin="0,0,0,16" Visibility="Collapsed" MaxHeight="260">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"
                           x:Name="AlertHeader" Text="ALERTS" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AlertList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{Binding AccentBrush}" BorderThickness="3,0,0,0"
                                        Padding="14,10" Margin="0,0,0,8" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{Binding AccentBrush}" />
                                        <TextBlock Text="{Binding Explanation}" FontSize="14"
                                                   LineHeight="21" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding When}" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="EVENT FEED" />

                <!--
                    The count line says what the feed is NOT showing. Image loads arrive in
                    the thousands per second and are hidden so they do not bury everything
                    else; hiding them silently would be the same move this tool refuses to
                    make anywhere else.
                -->
                <TextBlock DockPanel.Dock="Bottom" x:Name="WatchCounts" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FeedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding When}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Marker}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Margin="0,0,10,0"
                                               Foreground="{Binding MarkerBrush}" />
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
