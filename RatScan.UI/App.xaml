<Application x:Class="RatScan.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RatScan.UI"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                WPF-UI supplies the Fluent control templates and the dark theme brushes
                (TextFillColorPrimary, CardBackgroundFillColorDefault, and the rest).
                Merged first so everything declared below overrides it rather than the
                other way round.

                Theme is pinned to Dark rather than following the system. This window is
                read in the dark by someone who suspects they are being watched, and a
                light flip driven by a Windows setting is not a decision this app should
                make on their behalf.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

        <!--
            The palette and the default text style live here, at application scope, and
            they need to stay here.

            They were in MainWindow.Resources, and an implicit TextBlock style at window
            scope does not reach TextBlocks created from a DataTemplate. Every directly
            declared TextBlock was themed; every templated one silently fell back to
            WPF's default black. So "RustDesk is running" rendered near-black on a
            near-black card while the paragraph directly beneath it, which carries an
            explicit colour, looked correct — which is why the bug is invisible when
            reading the XAML.

            Any default text colour added at window scope inherits the same trap.
        -->
        <!--
            Card and SectionTitle are application-scoped for the same reason, and now for a
            second one: every view is a Page hosted by the navigation shell, so a style at
            window scope is not merely unreliable inside DataTemplates - it is invisible to
            the pages entirely. Defining them here is what makes the four views look like
            one product.
        -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <!-- Body Strong in the Fluent ramp: section headers read at the same size as the
             body they head, distinguished by weight rather than by being smaller. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Fluent Body: 14px is the smallest size this ramp uses for prose, and the
             foreground now comes from the theme so templated text tracks it too. The
             12px floor for dense data is applied per element, never here. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Every ScrollViewer in the app scrolls by hand. WPF's built-in wheel handling
            jumps a fixed distance per notch and ignores how far the gesture actually
            went, so a precision touchpad - which reports many small deltas per swipe -
            gets a full jump for each one and the content flies. Scrolling by the delta
            instead makes the movement track the finger.
        -->
        <Style TargetType="ScrollViewer">
            <EventSetter Event="PreviewMouseWheel" Handler="OnScrollViewerPreviewMouseWheel" />
        </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
