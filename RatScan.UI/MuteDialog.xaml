<Window x:Class="RatScan.UI.MuteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mute this finding" Height="440" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#0F1115">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#E6E8EC" />
        <SolidColorBrush x:Key="Muted" Color="#8B93A1" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />

        <Border Grid.Row="1" Background="#161A21" BorderBrush="#242A34" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="WHAT MUTING DOES" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                <TextBlock x:Name="PinText" FontSize="12" LineHeight="18"
                           Foreground="{StaticResource Muted}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,18,0,6" FontSize="12.5"
                   Text="Why is this yours? This is recorded with the entry and shown back to you on every scan." />

        <TextBox Grid.Row="3" x:Name="ReasonBox" Margin="0,0,0,4"
                 Background="#161A21" Foreground="{StaticResource Ink}" CaretBrush="#E6E8EC"
                 BorderBrush="#242A34" BorderThickness="1" Padding="10" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#E8C939" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
            <Button Content="Cancel" Click="OnCancel" Background="#2A3242" Margin="0,0,10,0" />
            <Button Content="Mute this finding" Click="OnConfirm" Background="#4C8DFF" />
        </StackPanel>
    </Grid>
</Window>
