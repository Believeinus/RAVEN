<!--
    Muting is the one control in RAVEN that makes it report less, so this dialog is the
    guard in front of it: it says what the mute will actually be worth before the user
    commits, and the primary button is named after the action rather than "OK".

    It is a ContentDialog rather than a Window because a mute is a decision about the
    finding on screen behind it - a separate top-level window took that context away and
    arrived wearing the system title bar, which is the look of a dialog people dismiss
    without reading.
-->
<ui:ContentDialog x:Class="RatScan.UI.MuteDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:local="clr-namespace:RatScan.UI"
                  PrimaryButtonText="Mute this finding"
                  CloseButtonText="Cancel"
                  DefaultButton="Close"
                  DialogMaxWidth="640">

    <!--
        WPF-UI's ContentDialog style is implicit, keyed on the exact type, so a subclass
        gets no control template at all: no surface, no title, and - the part that made
        this a defect rather than a blemish - no footer buttons, leaving a dialog with no
        way out. Naming the base style explicitly is what restores the template.
    -->
    <ui:ContentDialog.Style>
        <Style TargetType="{x:Type local:MuteDialog}"
               BasedOn="{StaticResource {x:Type ui:ContentDialog}}" />
    </ui:ContentDialog.Style>

    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="WHAT MUTING DOES" Style="{StaticResource SectionTitle}" />
                <TextBlock x:Name="PinText" FontSize="12" LineHeight="18"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <TextBlock Margin="0,18,0,8"
                   Text="Why is this yours? This is recorded with the entry and shown back to you on every scan." />

        <ui:TextBox x:Name="ReasonBox"
                    MinHeight="110"
                    PlaceholderText="It is my own remote support tool, installed by me."
                    AcceptsReturn="True" TextWrapping="Wrap"
                    VerticalContentAlignment="Top"
                    VerticalScrollBarVisibility="Auto"
                    TextChanged="OnReasonChanged" />

        <!--
            Stated up front rather than only after a rejected click, and it turns amber if
            the mute is actually refused.

            The button is deliberately left enabled: WPF-UI collapses a disabled footer
            button rather than greying it, so gating on IsPrimaryButtonEnabled produced a
            dialog whose only visible action was Cancel. Refusing the close is the honest
            version - the way out is visible, and it says why it will not open.
        -->
        <TextBlock x:Name="ValidationText" Margin="0,8,0,0" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Muting needs a reason — a silent hole in a scan is one nobody can explain later, including the person who made it." />
    </StackPanel>
</ui:ContentDialog>
